STAGEPILOT_APP_NAME=StagePilot Automation
STAGEPILOT_APP_ENV=local
STAGEPILOT_LOG_LEVEL=INFO
STAGEPILOT_LOG_JSON=true

STAGEPILOT_MYSQL_HOST=localhost
STAGEPILOT_MYSQL_PORT=3306
STAGEPILOT_MYSQL_USER=stagepilot
STAGEPILOT_MYSQL_PASSWORD=stagepilot
STAGEPILOT_MYSQL_DATABASE=stagepilot

STAGEPILOT_DATA_DIR=data
STAGEPILOT_MASTER_PROFILE_JSON_PATH=data/master_profile/master_profile.json

STAGEPILOT_DISCOVERY_HTTP_TIMEOUT_SECONDS=20
STAGEPILOT_DISCOVERY_RETRY_ATTEMPTS=3
STAGEPILOT_DISCOVERY_USER_AGENT=StagePilotAutomation/0.1

STAGEPILOT_EMAIL_DRY_RUN=true
STAGEPILOT_TELEGRAM_ALLOWED_USER_ID=
STAGEPILOT_GEMINI_API_KEY=
STAGEPILOT_OPENROUTER_API_KEY=
